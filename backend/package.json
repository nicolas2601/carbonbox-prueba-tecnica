{
  "name": "carbonbox-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Asynchronous document processing API and worker",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "tsx watch src/main/index.ts",
    "start": "tsx src/main/index.ts",
    "worker": "tsx src/workers/FileProcessingWorker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "convict": "^6.2.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/convict": "^6.1.6",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
