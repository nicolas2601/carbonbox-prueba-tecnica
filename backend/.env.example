# Copy to .env. Every value has a working default for local development.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# Must match docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/document_processing

# API and worker run as separate processes: both must read the same directory.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

CORS_ORIGIN=http://localhost:3000

WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=500
