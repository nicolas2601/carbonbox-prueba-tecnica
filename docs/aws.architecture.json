  "cards": [
    {
      "dot": "cyan",
      "title": "Network",
      "items": [
        "CloudFront terminates TLS before the load balancer",
        "Load balancer in public subnets, services and database in private subnets",
        "sg-app allows only the load balancer on the app ports"
      ]
    },
    {
      "dot": "emerald",
      "title": "Asynchronous path",
      "items": [
        "The API stores the file in S3 and enqueues a job in SQS",
        "The worker reads the file and writes rows in batches",
        "Jobs that fail three times land in the dead letter queue of the SQS queue"
      ]
    },
    {
      "dot": "rose",
      "title": "What this exercise runs",
      "items": [
        "PostgreSQL stands in for SQS, the local disk for S3",
        "Logs go to the console; CloudWatch is the target",
        "Cognito is not built: there is a single user"
      ]
    }
  ]
