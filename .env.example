# Used by docker-compose.yml. Copy to .env to override the defaults.
POSTGRES_DB=document_processing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Optional docker-compose.dev.yml host access only; not published by default.
POSTGRES_PORT=5433

# Local compose ports. These defaults are not production credentials.
API_PORT=3001
FRONTEND_PORT=3000
IMAGE_TAG=local
# Optional public-origin overrides; otherwise derived from API_PORT/FRONTEND_PORT.
# NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
STORAGE_DRIVER=fs

# Private metrics listener: never publish this port externally.
METRICS_HOST=127.0.0.1
METRICS_PORT=9090
RATE_LIMIT_MAX=600
UPLOAD_RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Optional local MinIO profile. Replace these public development defaults.
S3_BUCKET=carbonbox
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
